{
  "name": "shibaox",
  "version": "0.2.2",
  "description": "shibaox: an agentic OS for software teams (CLI, daemon and dashboard)",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "shibaox": "./dist/index.js"
  },
  "files": [
    "LICENSE",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@wizardingcode/shibaox-adapter-claude-code": "workspace:*",
    "@wizardingcode/shibaox-adapter-direct": "workspace:*",
    "@wizardingcode/shibaox-app": "workspace:*",
    "@wizardingcode/shibaox-bridge": "workspace:*",
    "@wizardingcode/shibaox-core": "workspace:*",
    "@wizardingcode/shibaox-daemon": "workspace:*",
    "@wizardingcode/shibaox-jev": "workspace:*",
    "@wizardingcode/shibaox-memory": "workspace:*",
    "@wizardingcode/shibaox-persistence-sqlite": "workspace:*",
    "@wizardingcode/shibaox-providers": "workspace:*",
    "@wizardingcode/shibaox-schemas": "workspace:*",
    "@wizardingcode/shibaox-tui": "workspace:*",
    "@wizardingcode/shibaox-workspace": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.20.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WizardingCode-io/shibaox.git"
  }
}
