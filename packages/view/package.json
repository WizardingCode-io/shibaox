{
  "name": "@wizardingcode/shibaox-view",
  "version": "0.2.7",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Pure derivations shared by the shibaox dashboards: run timelines, threads, requests (no Node APIs)",
  "files": [
    "LICENSE",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@wizardingcode/shibaox-core": "workspace:*",
    "@wizardingcode/shibaox-daemon": "workspace:*",
    "@wizardingcode/shibaox-schemas": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WizardingCode-io/shibaox.git"
  },
  "peerDependencies": {
    "@wizardingcode/shibaox-core": ">=0.2.0",
    "@wizardingcode/shibaox-daemon": ">=0.2.0",
    "@wizardingcode/shibaox-schemas": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "@wizardingcode/shibaox-core": {
      "optional": true
    },
    "@wizardingcode/shibaox-daemon": {
      "optional": true
    },
    "@wizardingcode/shibaox-schemas": {
      "optional": true
    }
  }
}
